{
  "manifest_version": 3,
  "name": "PACT wallet",
  "version": "0.1.0",
  "description": "Your PACT identity: the root certificate that issues a host its leaf. Nothing signs without your click in this window.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "PACT wallet" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
